[Unit]
Description=Local mail categorizer (docker compose)
Requires=docker.service
After=docker.service network-online.target
# Never start on the bare disk: wait for the LUKS volume and the backup disk.
RequiresMountsFor=/srv/mailcat /mnt/backup

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mailcat
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target

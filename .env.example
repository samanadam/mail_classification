# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- secrets -----------------------------------------------------------------
# Database password (any long random string): openssl rand -base64 32
POSTGRES_PASSWORD=
# Mailbox credential encryption key. Generate with:
#   docker compose run --rm --no-deps api mailcat gen-key
# Losing it means re-entering every account password; keep a copy in your password manager.
MAILCAT_SECRET_KEY=
# Backup encryption passphrase (16+ characters). Store it outside this server.
MAILCAT_BACKUP_PASSPHRASE=
# Discord webhook for alerts (optional but recommended)
MAILCAT_DISCORD_WEBHOOK_URL=

# --- network -----------------------------------------------------------------
# Address the dashboard binds to. Use 127.0.0.1 with `tailscale serve` (recommended, HTTPS),
# or this machine's Tailscale IP (100.x.y.z). Never 0.0.0.0.
BIND_ADDR=127.0.0.1
API_PORT=8080
# true when the dashboard is reached over HTTPS (tailscale serve)
MAILCAT_COOKIE_SECURE=true

# --- storage -----------------------------------------------------------------
# Must be on the LUKS-encrypted volume (see docs/operations.md)
MAILCAT_ROOT=/srv/mailcat
# Second disk
MAILCAT_BACKUP_ROOT=/mnt/backup/mailcat

# --- classifier --------------------------------------------------------------
# laya | laya_onnx | ollama | rules_only
MAILCAT_CLASSIFIER=laya
MAILCAT_LAYA_MODEL=convaiinnovations/laya
MAILCAT_LAYA_SUBFOLDER=multilingual
# Pin the model revision you evaluated in phase 0 (a commit SHA from the Hugging Face repo)
MAILCAT_LAYA_REVISION=
# Only for MAILCAT_CLASSIFIER=ollama
MAILCAT_OLLAMA_URL=http://host.docker.internal:11434
MAILCAT_OLLAMA_MODEL=qwen2.5:3b

# --- resources ---------------------------------------------------------------
WORKER_MEM_LIMIT=3g
WORKER_CPUS=2
MAILCAT_CLAMAV_MODE=managed
MAILCAT_LOG_LEVEL=INFO
